# =============================================================
# .env.example - Template mẫu (SAFE to commit lên Git)
# Sao chép file này thành .env và điền thông tin thực tế vào
# cp .env.example .env
# =============================================================

# --- GRAFANA SETTINGS ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
GRAFANA_CONTAINER_NAME=grafana-prtg
GRAFANA_PORT=3000
TZ=Asia/Ho_Chi_Minh
GF_PLUGINS_ALLOW_LOADING_UNSIGNED_PLUGINS=jasonlashua-prtg-datasource
GF_ANALYTICS_REPORTING_ENABLED=false
GF_ANALYTICS_CHECK_FOR_UPDATES=false

# --- PRTG DATASOURCE SETTINGS ---
PRTG_URL=https://192.168.x.x
PRTG_USERNAME=your_prtg_user
PRTG_PASSHASH=your_passhash_here
PRTG_VERIFY_SSL=false
